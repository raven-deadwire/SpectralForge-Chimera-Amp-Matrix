{
  "schema": "spectralforge.chimera.ci-check-map",
  "schema_version": 1,
  "policy_version": 4,
  "checks": {
    "A12.01": {
      "name": "Portable core and preset regression",
      "producer": "ctest:ChimeraTests",
      "platform": "all",
      "artifact": "LastTest.log"
    },
    "A12.02": {
      "name": "Transpose, gate and tail stability regression",
      "producer": "ctest:ChimeraStabilityTests",
      "platform": "all",
      "artifact": "LastTest.log"
    },
    "A12.03": {
      "name": "Universal PRE board regression",
      "producer": "ctest:ChimeraPedalBoardTests",
      "platform": "all",
      "artifact": "LastTest.log"
    },
    "A12.04": {
      "name": "IR collection, integrity and fallback regression",
      "producer": "ctest:ChimeraIRCollectionTests",
      "platform": "all",
      "artifact": "LastTest.log"
    },
    "A12.05": {
      "name": "Appended amp topology and legacy preservation regression",
      "producer": "ctest:ChimeraNewAmpTests",
      "platform": "all",
      "artifact": "LastTest.log"
    },
    "A12.06": {
      "name": "Native amp control and DSP regression",
      "producer": "ctest:ChimeraAmpNativeTests",
      "platform": "all",
      "artifact": "LastTest.log"
    },
    "A12.07": {
      "name": "Native POST control, state and DSP regression",
      "producer": "ctest:ChimeraPostNativeTests",
      "platform": "all",
      "artifact": "LastTest.log"
    },
    "A13.01": {
      "name": "Windows full CTest matrix",
      "producer": "workflow:build/windows",
      "platform": "windows",
      "artifact": "Chimera-DSP-verification-Windows"
    },
    "A13.02": {
      "name": "Linux full CTest matrix",
      "producer": "workflow:build/linux",
      "platform": "linux",
      "artifact": "Chimera-DSP-verification-Linux"
    },
    "A13.03": {
      "name": "macOS universal full CTest matrix",
      "producer": "workflow:build/macos",
      "platform": "macos",
      "artifact": "Chimera-DSP-verification-macOS"
    },
    "A13.04": {
      "name": "Windows installer install, repair and uninstall",
      "producer": "workflow:Verify-WindowsInstaller",
      "platform": "windows",
      "artifact": "Chimera-Windows-installer-verification"
    },
    "A13.05": {
      "name": "Windows MSIX deployment and activation",
      "producer": "workflow:Verify-WindowsMSIX",
      "platform": "windows",
      "artifact": "Chimera-Windows-MSIX-verification"
    },
    "A13.06": {
      "name": "Windows distribution Defender scan",
      "producer": "workflow:Scan-WindowsArtifacts",
      "platform": "windows",
      "artifact": "Chimera-Windows-security-report"
    },
    "A13.07": {
      "name": "Exact-source release candidate assembly",
      "producer": "workflow:assemble-candidate",
      "platform": "all",
      "artifact": "SpectralForge-Chimera-<source-version>-Release-Candidate"
    },
    "I1.PITCH": {
      "name": "Low-bin energy and unchanged raw mapping",
      "producer": "ctest:ChimeraPitchRegressionTests",
      "platform": "all",
      "artifact": "ctest-results.xml"
    },
    "I1.GATE": {
      "name": "Combined Range manifest, state and routing",
      "producer": "ctest:ChimeraGateProcessorTests",
      "platform": "all",
      "artifact": "ctest-results.xml"
    },
    "I1.STATE_GAIN_GR": {
      "name": "Full Guitar state, unity level and compressor GR",
      "producer": "ctest:ChimeraIntegratedProcessorTests",
      "platform": "all",
      "artifact": "ctest-results.xml"
    },
    "I1.LIVE_REMOVE": {
      "name": "Live project deletion with surviving peers",
      "producer": "ctest:ChimeraVST3LifecycleTests",
      "platform": "windows",
      "artifact": "ctest-results.xml"
    },
    "E1.DSP": {
      "name": "E670FE native DSP and control coverage",
      "producer": "ctest-contract:E1.DSP",
      "platform": "all",
      "artifact": "ctest-results.xml + LastTest.log",
      "tests": {
        "ChimeraAmpNativeTests": [
          "PASS catalog 26 serialized / 25 active models, 407 controls, six contexts",
          "CONTROL_RESPONSE count=407 failures=0 minimum=\\S+ at=\\S+",
          "GAIN_RANGE model=23 channel=2 thd_low=\\S+ thd_mid=\\S+",
          "GAIN_DEFAULT model=23 channel=2 weak_thd=\\S+ growth_db=\\S+",
          "GAIN_DEFAULT model=23 channel=3 weak_thd=\\S+ growth_db=\\S+",
          "PASS sample-rates/channel routes=183 peak=\\S+ allocations=0",
          "PASS inactive channel controls isolated=448 output level ratio=\\S+",
          "PASS integrated native oversampling paths=104",
          "PASS AmpNativeTests"
        ]
      },
      "definition_source": "docs/E670FE_IMPLEMENTATION.md#compatibility"
    },
    "E1.STATE_UI": {
      "name": "E670FE six-context state and native UI coverage",
      "producer": "ctest-contract:E1.STATE_UI",
      "platform": "windows",
      "artifact": "ctest-results.xml + LastTest.log",
      "tests": {
        "ChimeraUITests": [
          "PASS: six native amp contexts, all native banks, POST nine models, binary/A-B recall and immediate pedal bank recall",
          "PASS native UI: all 26 serialized amplifier panels at 100/75%, 122 channel cases, 2246 channel/control visibility cases, Matrix LOW priority controls and ALL, 9 POST models / 144 controls at 100/75%, flat POST alias menus and short original model captions, six compact rack rows and ALL dialogs, editor teardown and real parameter callbacks"
        ]
      },
      "definition_source": "docs/E670FE_IMPLEMENTATION.md#compatibility"
    },
    "E1.LEGACY": {
      "name": "E670FE append-only and legacy compatibility",
      "producer": "ctest-contract:E1.LEGACY",
      "platform": "all",
      "artifact": "ctest-results.xml + LastTest.log",
      "tests": {
        "ChimeraGateProcessorTests": [
          "PASS legacy parameter contract: 3686 entries SHA256 [0-9a-f]{64} approved_112_defaults=111 numeric_rounding_differences=\\d+; append-only gateRangeDb",
          "PASS binary state, legacy missing-field migration, A/B, factory reset, host gestures and MIDI automation recall"
        ]
      },
      "windows_tests": {
        "ChimeraUITests": [
          "PASS: six native amp contexts, all native banks, POST nine models, binary/A-B recall and immediate pedal bank recall",
          "PASS: legacy amp normalized/index/label compatibility; 8 appended models; independent lane/channel banks; binary and A/B recall; old-state and factory migration"
        ]
      },
      "definition_source": "docs/E670FE_IMPLEMENTATION.md#compatibility"
    }
  }
}

