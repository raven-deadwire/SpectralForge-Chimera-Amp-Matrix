# Public, digest-only verifier data. No secret or plaintext code is accepted.
# Kept independently callable for configuration regression tests (cmake -P).
function(chimera_configure_tester_allowlist manifest output_header)
  if(NOT EXISTS "${manifest}" OR IS_DIRECTORY "${manifest}")
    message(FATAL_ERROR "Tester allowlist manifest is missing")
  endif()
  file(SIZE "${manifest}" manifest_size)
  if(manifest_size GREATER 524288)
    message(FATAL_ERROR "Tester allowlist manifest is too large")
  endif()
  file(READ "${manifest}" manifest_json)
  string(JSON root_type ERROR_VARIABLE json_error TYPE "${manifest_json}")
  if(json_error OR NOT root_type STREQUAL "OBJECT")
    message(FATAL_ERROR "Tester allowlist must be a JSON object")
  endif()
  string(JSON field_count LENGTH "${manifest_json}")
  if(NOT field_count EQUAL 2)
    message(FATAL_ERROR "Tester allowlist permits only schema and digests")
  endif()
  string(JSON schema_type ERROR_VARIABLE json_error TYPE "${manifest_json}" schema)
  if(json_error OR NOT schema_type STREQUAL "STRING")
    message(FATAL_ERROR "Tester allowlist schema must be a string")
  endif()
  string(JSON schema GET "${manifest_json}" schema)
  if(NOT schema STREQUAL "spectralforge.chimera.tester-allowlist.v1")
    message(FATAL_ERROR "Unknown tester allowlist schema")
  endif()
  string(JSON digests_type ERROR_VARIABLE json_error TYPE "${manifest_json}" digests)
  if(json_error OR NOT digests_type STREQUAL "ARRAY")
    message(FATAL_ERROR "Tester allowlist digests must be an array")
  endif()
  string(JSON digest_count LENGTH "${manifest_json}" digests)
  if(digest_count GREATER 4096)
    message(FATAL_ERROR "Tester allowlist exceeds 4096 entries")
  endif()
  set(entries "")
  set(seen_digests "")
  if(digest_count GREATER 0)
    math(EXPR last_index "${digest_count} - 1")
    foreach(index RANGE 0 ${last_index})
      string(JSON digest_type TYPE "${manifest_json}" digests ${index})
      if(NOT digest_type STREQUAL "STRING")
        message(FATAL_ERROR "Tester allowlist entries must be digest strings")
      endif()
      string(JSON digest GET "${manifest_json}" digests ${index})
      string(LENGTH "${digest}" digest_length)
      if(NOT digest_length EQUAL 64 OR NOT digest MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "Tester allowlist entries must be 64 lowercase hexadecimal characters")
      endif()
      if(digest IN_LIST seen_digests)
        message(FATAL_ERROR "Tester allowlist contains duplicate digests")
      endif()
      list(APPEND seen_digests "${digest}")
      string(APPEND entries "    \"${digest}\",\n")
    endforeach()
  endif()
  get_filename_component(output_directory "${output_header}" DIRECTORY)
  file(MAKE_DIRECTORY "${output_directory}")
  set(header "#pragma once\n// Generated public verifier digests only; never place plaintext codes here.\n#define CHIMERA_TESTER_ALLOWLIST_HEADER_INCLUDED 1\ninline constexpr const char* chimeraTesterAllowlistDigests[] = {\n${entries}    nullptr\n};\n")
  # write-if-changed keeps unchanged translation units reusable.
  if(EXISTS "${output_header}")
    file(READ "${output_header}" previous_header)
  else()
    set(previous_header "")
  endif()
  if(NOT previous_header STREQUAL header)
    file(WRITE "${output_header}" "${header}")
  endif()
  if(digest_count GREATER 0)
    message(STATUS "Beta tester codes: ${digest_count} preapproved public digests")
  else()
    message(STATUS "Beta tester codes: disabled (empty public allowlist)")
  endif()
endfunction()
