# Read the same source consumed by Python packaging and Windows Setup.
file(READ "${CMAKE_CURRENT_LIST_DIR}/../VERSION" CHIMERA_PRODUCT_VERSION)
string(STRIP "${CHIMERA_PRODUCT_VERSION}" CHIMERA_PRODUCT_VERSION)
if(NOT CHIMERA_PRODUCT_VERSION MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$")
  message(FATAL_ERROR "VERSION must contain exactly major.minor.patch")
endif()
string(REPLACE "." ";" CHIMERA_VERSION_PARTS "${CHIMERA_PRODUCT_VERSION}")
foreach(part IN LISTS CHIMERA_VERSION_PARTS)
  if(part GREATER 65535)
    message(FATAL_ERROR "VERSION components must fit Windows version resources")
  endif()
endforeach()
set(CHIMERA_RELEASE_CHANNEL "preview")
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/../RELEASE_CHANNEL")
  file(READ "${CMAKE_CURRENT_LIST_DIR}/../RELEASE_CHANNEL" CHIMERA_RELEASE_CHANNEL)
  string(STRIP "${CHIMERA_RELEASE_CHANNEL}" CHIMERA_RELEASE_CHANNEL)
endif()
if(NOT CHIMERA_RELEASE_CHANNEL MATCHES "^(preview|stable|(beta|rc)\\.[1-9][0-9]*)$")
  message(FATAL_ERROR "RELEASE_CHANNEL must be preview, stable, beta.N or rc.N (N > 0)")
endif()
function(chimera_set_package_identity)
  if(CHIMERA_RELEASE_CHANNEL STREQUAL "preview")
    set(CHIMERA_PACKAGE_VERSION "${PROJECT_VERSION}-preview.${CHIMERA_BUILD_REVISION}" PARENT_SCOPE)
    set(CHIMERA_PACKAGE_DISPLAY "${PROJECT_VERSION} Preview ${CHIMERA_BUILD_REVISION}" PARENT_SCOPE)
    set(CHIMERA_UPDATE_CHANNEL "beta" PARENT_SCOPE)
    set(CHIMERA_UPDATE_MANIFEST "update-beta.json" PARENT_SCOPE)
  elseif(CHIMERA_RELEASE_CHANNEL STREQUAL "stable")
    set(CHIMERA_PACKAGE_VERSION "${PROJECT_VERSION}" PARENT_SCOPE)
    set(CHIMERA_PACKAGE_DISPLAY "${PROJECT_VERSION}" PARENT_SCOPE)
    set(CHIMERA_UPDATE_CHANNEL "stable" PARENT_SCOPE)
    set(CHIMERA_UPDATE_MANIFEST "update-stable.json" PARENT_SCOPE)
  else()
    string(LENGTH "${PROJECT_VERSION}-${CHIMERA_RELEASE_CHANNEL}" package_length)
    if(package_length GREATER 128)
      message(FATAL_ERROR "Package version exceeds updater version length limit")
    endif()
    set(CHIMERA_PACKAGE_VERSION "${PROJECT_VERSION}-${CHIMERA_RELEASE_CHANNEL}" PARENT_SCOPE)
    if(CHIMERA_RELEASE_CHANNEL MATCHES "^beta\\.")
      set(CHIMERA_PACKAGE_DISPLAY "Open Beta ${PROJECT_VERSION} (${CHIMERA_RELEASE_CHANNEL})" PARENT_SCOPE)
      set(CHIMERA_UPDATE_CHANNEL "beta" PARENT_SCOPE)
      set(CHIMERA_UPDATE_MANIFEST "update-beta.json" PARENT_SCOPE)
    else()
      string(REPLACE "rc." "" candidate_number "${CHIMERA_RELEASE_CHANNEL}")
      set(CHIMERA_PACKAGE_DISPLAY "${PROJECT_VERSION} Release Candidate ${candidate_number}" PARENT_SCOPE)
      set(CHIMERA_UPDATE_CHANNEL "rc" PARENT_SCOPE)
      set(CHIMERA_UPDATE_MANIFEST "update-rc.json" PARENT_SCOPE)
    endif()
  endif()
endfunction()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  "${CMAKE_CURRENT_LIST_DIR}/../VERSION" "${CMAKE_CURRENT_LIST_DIR}/../RELEASE_CHANNEL")
