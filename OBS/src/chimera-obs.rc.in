// Version resource of the Chimera OBS filter module (configured by CMake).
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "RavenForge Luthier Intelligence"
            VALUE "FileDescription", "SpectralForge Chimera OBS filter (GPL-2.0-or-later)"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "chimera-obs"
            VALUE "LegalCopyright", "Copyright (C) 2026 RavenForge Luthier Intelligence. GPL-2.0-or-later."
            VALUE "OriginalFilename", "chimera-obs.dll"
            VALUE "ProductName", "SpectralForge Chimera OBS filter"
            VALUE "ProductVersion", "@PROJECT_VERSION@ (@chimera_obs_source@)"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
