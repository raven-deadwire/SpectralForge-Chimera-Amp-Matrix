+inline void accumulateArmMac(const float* __restrict input,const float* __restrict impulse,
+                             float* __restrict output,int bins) noexcept
+{
+    // Apple Clang already emits eight-bin NEON for the scalar formulation,
+    // but versions each partition loop with repeated pointer-overlap checks.
+    // The three buffers are disjoint. Make the vector work explicit while
+    // retaining that compiler's fused multiply/add/subtract order per bin.
+    // Mono's N/2+1 bins also require unaligned planes and a scalar remainder.
+    const auto four=[=](int i) noexcept {
+        const auto inputReal=vld1q_f32(input+i);
+        const auto inputImag=vld1q_f32(input+bins+i);
+        const auto impulseReal=vld1q_f32(impulse+i);
+        const auto impulseImag=vld1q_f32(impulse+bins+i);
+        const auto outputReal=vld1q_f32(output+i);
+        const auto outputImag=vld1q_f32(output+bins+i);
+        const auto real=vfmsq_f32(vfmaq_f32(outputReal,impulseReal,inputReal),
+                                  impulseImag,inputImag);
+        const auto imag=vfmaq_f32(vfmaq_f32(outputImag,impulseImag,inputReal),
+                                  impulseReal,inputImag);
+        vst1q_f32(output+i,real);
+        vst1q_f32(output+bins+i,imag);
+    };
+    int i=0;
+    for(;i+8<=bins;i+=8) {four(i);four(i+4);}
+    if(i+4<=bins) {four(i);i+=4;}
+    for(;i<bins;++i) {
+        const float re=(output[i]+input[i]*impulse[i])-input[bins+i]*impulse[bins+i];
+        const float im=(output[bins+i]+input[i]*impulse[bins+i])+input[bins+i]*impulse[i];
+        output[i]=re;output[bins+i]=im;
+    }
+}
+}
