+void checkArmSpectralMac() {
+    // Independent scalar fused arithmetic checks lane ordering, odd imaginary
+    // plane alignment, vector/tail boundaries and repeated partition sums.
+    // This runs outside every measured callback population.
+    std::uint32_t state=0x54a921d3u;
+    const auto sample=[&]() {
+        state^=state<<13;state^=state>>17;state^=state<<5;
+        const float mantissa=float(int(state&65535u)-32768)/32768.f;
+        return std::ldexp(mantissa,int((state>>16)&15u)-12);
+    };
+    std::uint64_t compared=0;int geometries=0;
+    constexpr float sentinel=-12345.25f;
+    for(int bins:{1,3,4,5,7,8,9,65,128,129,256,257,512,513,1024}) {
+        for(int offset=1;offset<=4;++offset) {
+            std::vector<float> input(size_t(2*bins+8),sentinel),impulse(input.size(),sentinel);
+            std::vector<float> actual(input.size(),sentinel),expected(input.size(),sentinel);
+            for(int i=0;i<2*bins;++i)actual[size_t(offset+i)]=expected[size_t(offset+i)]=sample();
+            for(int partition=0;partition<73;++partition) {
+                for(int i=0;i<2*bins;++i) {
+                    input[size_t(offset+i)]=sample();impulse[size_t(offset+i)]=sample();
+                }
+                const auto inputBefore=input,impulseBefore=impulse;
+                const auto* in=input.data()+offset;
+                const auto* ir=impulse.data()+offset;
+                auto* out=expected.data()+offset;
+                #pragma clang loop vectorize(disable) interleave(disable)
+                for(int i=0;i<bins;++i) {
+                    const float re=std::fma(-in[bins+i],ir[bins+i],std::fma(in[i],ir[i],out[i]));
+                    const float im=std::fma(in[bins+i],ir[i],std::fma(in[i],ir[bins+i],out[bins+i]));
+                    out[i]=re;out[bins+i]=im;
+                }
+                spectralforge::cab_detail::accumulateArmMac(in,ir,actual.data()+offset,bins);
+                require(std::memcmp(actual.data(),expected.data(),actual.size()*sizeof(float))==0,
+                    "ARM spectral MAC differs from scalar fused reference or overwrites a guard");
+                require(std::memcmp(input.data(),inputBefore.data(),input.size()*sizeof(float))==0
+                    && std::memcmp(impulse.data(),impulseBefore.data(),impulse.size()*sizeof(float))==0,
+                    "ARM spectral MAC modifies its input spectra");
+                compared+=std::uint64_t(2*bins);
+            }
+            ++geometries;
+        }
+    }
+    std::cout<<"ARM_SPECTRAL_MAC_REFERENCE geometries="<<geometries
+        <<" partitions=73 float_comparisons="<<compared
+        <<" exact_bits=PASS input_immutable=PASS bounds_guards=PASS\n";
+}
+#endif
