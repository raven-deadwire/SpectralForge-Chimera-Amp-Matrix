+// V3 uses this same extended preparation. Geometry and common speaker/mic
+// response data live in originalCab::PreparedResponse, not a third schema.
+struct PreparedResponse {
+    originalCab::PreparedResponse base{};
+    const Driver* chosen{};
+    const Mic* mic{};
+    size_t tweeter{};
+    double hornCosine{},hornAngleSine{};
+    std::array<double,3> axialHz{};
+    double rearDamping{1};
+    bool originalFallback{},layoutResponse{};
+};
+inline void prepareRearPaths(PreparedResponse& prepared) {
+    auto& b=prepared.base;
+    if(b.parameters.rear)for(int n=0;n<b.count;++n) {
+        const auto source=b.points[size_t(n)];
+        const double edge=std::min(b.box.width*.5-std::abs(source.x),b.box.height*.5-std::abs(source.y));
+        b.rearPaths[size_t(n)]=std::hypot(std::hypot(b.pickup.x-source.x,b.pickup.y-source.y),b.z)+2*edge+b.box.depth;
+    }
+}
+inline void prepareMicrophoneAndHorn(PreparedResponse& prepared) {
+    auto& b=prepared.base;const auto* mic=prepared.mic;
+    b.microphone=prepareMicrophoneResponse(mic ? mic->response : originalCab::microphones[size_t(b.parameters.mic)],b.z);
+    prepared.hornCosine=b.z/b.hornPath;
+    if(mic)prepared.hornAngleSine=std::sqrt(std::max(0.,1-prepared.hornCosine*prepared.hornCosine));
+    constexpr std::array<double,4> focus{1.5,1.1,2.1,.7};
+    b.hornFocus=std::pow(prepared.hornCosine,focus[prepared.tweeter]);
+}
+inline PreparedResponse prepareResponse(Settings raw) {
+    const auto p=settings(key(raw));PreparedResponse prepared;
+    if(!p.driver && !p.mic && !p.tweeter) {
+        prepared.originalFallback=true;prepared.base=originalCab::prepareResponse(p.base);return prepared;
+    }
+    prepared.chosen=driver(p);prepared.mic=microphone(p);prepared.tweeter=size_t(p.tweeter);
+    const auto& d=prepared.chosen ? prepared.chosen->speaker : speakers[size_t(p.base.cabinet)];
+    auto& b=prepared.base;b.parameters=p.base;b.box=enclosure(p);b.count=4;
+    const auto points=centres(b.box);const auto selected=points[size_t(p.base.unit)];
+    std::copy(points.begin(),points.end(),b.points.begin());
+    b.pickup={selected.x+p.base.position*d.radius,selected.y};b.z=p.base.distanceCm*.01;
+    b.speaker=prepareSpeakerResponse(d,b.box,p.base.rear!=0);
+    prepareRearPaths(prepared);
+    b.hornPath=std::hypot(std::hypot(b.pickup.x,b.pickup.y),b.z);
+    prepareMicrophoneAndHorn(prepared);
+    return prepared;
+}
